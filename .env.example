# scripts/sync.mjs, backend/server.mjs 실행에 필요한 환경변수. 복사해서 .env로 저장 후 값 채우기.
# .env는 절대 커밋하지 말 것 (service_role 키는 RLS를 우회하는 관리자 권한 키).

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# backend/server.mjs의 쓰기 API(POST/PUT/DELETE) 인증에 사용. 임의의 긴 문자열로 설정.
ADMIN_TOKEN=change-me-to-a-random-string
